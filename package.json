{
  "name": "nyaworks",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pseudo-effects": "node scripts/build-shape-pseudo-effects.mjs",
    "build:watch": "vite build --watch",
    "setup:cep": "node scripts/setup-cep-dev.mjs",
    "dev:cep": "node scripts/dev-cep.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke:dist"
  },
  "dependencies": {
    "@icon-park/react": "1.4.2",
    "@phosphor-icons/react": "2.1.10",
    "pinyin-pro": "3.29.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.1.1",
    "iconv-lite": "^0.7.3",
    "jsdom": "26.1.0",
    "typescript": "5.6.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
